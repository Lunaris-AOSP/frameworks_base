<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Smartspace -->
    <attr format="dimension" name="remoteViewsCardCornerRadius" />
    <attr format="dimension" name="smartspaceSubtitleTextSize" />
    <attr format="dimension" name="smartspaceTitleTextSize" />
    <declare-styleable
        name="WeatherSmartspaceView">
        <attr format="dimension" name="iconInset" />
        <attr format="dimension" name="iconSize" />
        <attr format="boolean" name="removeTextDescent" />
        <attr format="dimension" name="textDescentExtraPadding" />
    </declare-styleable>

    <declare-styleable name="WeatherTextView">
        <attr name="weatherText" format="string" />
    </declare-styleable>

    <declare-styleable name="ProgressImageView">
        <attr name="typeface" format="string" />
    </declare-styleable>
</resources>
