<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start">

    <FrameLayout
        android:id="@+id/oos_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:tag="clock"
        android:layoutDirection="ltr">

        <TextClock
            android:id="@+id/oos_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:ellipsize="none"
            android:fontFeatureSettings="tnum"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:singleLine="true"
            android:useBoundsForWidth="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:ellipsize="none"
            android:fontFeatureSettings="tnum"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:singleLine="true"
            android:useBoundsForWidth="true"
            android:textColor="@android:color/system_accent1_300"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextClock
        android:id="@+id/oos_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:format12Hour="EEEE, MMM dd"
        android:format24Hour="EEEE, dd MMM"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
