<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:gravity="center_horizontal|top"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, d MMM"
            android:gravity="center"
            android:singleLine="true"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="17dp" />

        <com.android.systemui.weather.WeatherImageView
            android:id="@+id/weather_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

        <com.android.systemui.weather.WeatherTextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@android:color/white"
            android:textSize="17dp"
            android:visibility="gone" />

    </LinearLayout>

    <com.android.systemui.clocks.HyperClockView
        android:id="@+id/hyper_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        app:hyperMode="art"
        app:hyperFamily="b"
        app:hyperEmSize="94dp"
        app:hyperShowColon="true"
        app:hyperMinuteAlpha="1"
        app:hyperArtGapX="-0.28"
        app:hyperArtDropY="0.54"
        app:hyperArtRowDx="-0.32"
        app:hyperArtRowDy="1"
        app:hyperColonScale="1.36"
        app:hyperColonDx="-0.03"
        app:hyperColonDy="0.07"
        app:hyperColonOnTop="true"
        app:hyperColonColor="#FFFA2A2A" />

</LinearLayout>
